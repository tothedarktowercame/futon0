#!/usr/bin/env bash
set -euo pipefail
#
# cz — ZAI lane in the terminal, the zai sibling of cr/cx.
#
# Opens *zai-repl:zai-N* Emacs lanes with the same numbering rule as cx
# (2026-08-12, Joe): lane numbers depend on WHAT NUMBERS EXIST in the
# local site display column (plain zai-N and <site>-zai-N), never on
# attached/busy status.
#
# Usage:
#   cz                    # attach highest existing plain zai-N (mint if none)
#   cz new | cz --new     # mint smallest unused zai-N, open fresh lane
#   cz -a zai-5           # target a specific lane id (registers it if new)
#   cz zai-5              # same as -a zai-5
#
# Requires: futon3c checkout (FUTON3C_ROOT or ~/code/futon3c), Agency on
# FUTON3C_PORT (default 7070), Emacs daemon (socket discovered via
# emacs-socket-lib.sh).

futon3c_root="${FUTON3C_ROOT:-${HOME}/code/futon3c}"
agency_base="${FUTON3C_BASE:-http://127.0.0.1:${FUTON3C_PORT:-7070}}"
emacsclient_bin="${EMACSCLIENT_BIN:-emacsclient}"
site="${FUTON_SITE:-ams}"
cwd_for_agent="${FUTON3C_BOOTSTRAP_AGENT_CWD:-${HOME}/code}"

socket_lib="${futon3c_root}/scripts/emacs-socket-lib.sh"
if [[ -f "${socket_lib}" ]]; then
  # shellcheck source=/dev/null
  source "${socket_lib}"
fi

start_new=false
lane_id="${AGENCY_AGENT_ID:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    new|--new) start_new=true; shift ;;
    -a|--agent)
      shift
      [[ $# -gt 0 ]] || { echo "cz: -a needs a lane id (e.g. zai-5)" >&2; exit 1; }
      lane_id="$1"; shift ;;
    -h|--help)
      sed -n '3,19p' "$(readlink -f "${BASH_SOURCE[0]}")" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    zai-*) lane_id="$1"; shift ;;
    *) echo "cz: unknown argument: $1" >&2; exit 1 ;;
  esac
done

if ! curl -sS --max-time 2 "${agency_base%/}/api/alpha/agents" >/dev/null 2>&1; then
  echo "cz: Agency not reachable at ${agency_base} — start it first." >&2
  exit 1
fi

# Numbering by name-existence, local-site-scoped (see cx / codex-picker).
if [[ -z "${lane_id}" ]]; then
  lane_id="$(curl -sS --max-time 5 "${agency_base%/}/api/alpha/agents" \
    | python3 -c '
import json, re, sys
mode, site = sys.argv[1], sys.argv[2]
try:
    ids = list((json.load(sys.stdin).get("agents") or {}).keys())
except Exception:
    ids = []
used = set()
plain = []
for i in ids:
    m = re.fullmatch(r"zai-([0-9]+)", i) or re.fullmatch(
        re.escape(site) + r"-zai-([0-9]+)", i)
    if m:
        used.add(int(m.group(1)))
    if re.fullmatch(r"zai-([0-9]+)", i):
        plain.append(int(i.rsplit("-", 1)[1]))
if mode == "attach" and plain:
    print(f"zai-{max(plain)}")
else:
    n = 1
    while n in used:
        n += 1
    print(f"zai-{n}")' "$( $start_new && echo new || echo attach )" "${site}")"
fi

# Register.
#
# POST /api/alpha/agents installs a STUB invoke-fn returning
# {:result "registered-via-http"} that never calls the model
# (transport/http.clj:2705). For an id that ALREADY exists this is harmless --
# 409, real invoke-fn untouched -- which is why attaching has always worked.
# Minting a genuinely new lane through it yields a seat that answers
# "registered-via-http" to everything, silently, while the roster reports
# invoke-ready? true (the stub IS a registered invoke-fn).
#
# POST /api/alpha/agents/auto is the endpoint that builds a real invoke-fn.
# It is what scripts/systemd/bootstrap-local-agents uses, what cr and cx use,
# and what the tracked futon0/scripts/cz used before the 2026-08-12 rewrite
# of this file dropped it.
if curl -fsS --max-time 3 "${agency_base%/}/api/alpha/agents/${lane_id}" \
     >/dev/null 2>&1; then
  : # exists already; leave its invoke-fn alone
else
  auto_response="$(curl -sS --max-time 15 -H "Content-Type: application/json" \
    -X POST -d "{\"type\":\"zai\",\"cwd\":\"${cwd_for_agent}\"}" \
    "${agency_base%/}/api/alpha/agents/auto" || true)"
  auto_id="$(printf '%s' "${auto_response}" | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    print(d.get("agent-id") or "" if d.get("ok") else "")
except Exception:
    print("")' 2>/dev/null || true)"
  if [[ -z "${auto_id}" ]]; then
    echo "cz: could not mint a zai lane via /api/alpha/agents/auto" >&2
    echo "cz: response was: ${auto_response}" >&2
    exit 1
  fi
  if [[ "${auto_id}" != "${lane_id}" ]]; then
    # /auto allocates its own next-unused id and cannot be told which to use.
    # Adopt it rather than falling back to the stub path.
    echo "cz: requested ${lane_id}, Agency allocated ${auto_id} — using ${auto_id}" >&2
    lane_id="${auto_id}"
  fi
fi

session_file="/tmp/futon-zai-session-id-${lane_id}"
if $start_new; then
  rm -f "${session_file}"
fi

socket_name=""
if declare -F futon_preferred_emacs_socket >/dev/null 2>&1; then
  socket_name="$(futon_preferred_emacs_socket || true)"
fi
socket_args=()
[[ -n "${socket_name}" ]] && socket_args=(-s "${socket_name}")

esc() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1])[1:-1])' "$1"; }
agent_chat_el="$(esc "${futon3c_root}/emacs/agent-chat.el")"
zai_repl_el="$(esc "${futon3c_root}/emacs/zai-repl.el")"
esc_lane="$(esc "${lane_id}")"
esc_sf="$(esc "${session_file}")"

echo "cz: lane ${lane_id} (session file ${session_file})"
"${emacsclient_bin}" "${socket_args[@]}" --timeout 8 --no-wait -e "(progn
  (load \"${agent_chat_el}\" nil t)
  (load \"${zai_repl_el}\" nil t)
  (zai-repl--open-instance (format \"*zai-repl:%s*\" \"${esc_lane}\")
                           \"${esc_lane}\"
                           \"${esc_sf}\"))" >/dev/null
echo "cz: opened *zai-repl:${lane_id}*"
